{
  "uid": "ojp-diagnostics",
  "title": "Open J Proxy — HTAP Diagnostics",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "utc",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "PostgreSQL physical connections", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [
      {"expr": "pg_stat_database_numbackends{datname=\"shop\"}", "legendFormat": "PostgreSQL sessions"},
      {"expr": "demo_postgres_physical_connections{mode=\"direct\"}", "legendFormat": "Direct application connections"},
      {"expr": "demo_postgres_physical_connections{mode=\"ojp\"}", "legendFormat": "OJP backend connections"}
    ]},
    {"id": 2, "type": "timeseries", "title": "PostgreSQL transactions per second", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [
      {"expr": "rate(pg_stat_database_xact_commit{datname=\"shop\"}[30s])", "legendFormat": "commits/s"},
      {"expr": "rate(pg_stat_database_xact_rollback{datname=\"shop\"}[30s])", "legendFormat": "rollbacks/s"}
    ]},
    {"id": 3, "type": "timeseries", "title": "PostgreSQL tuples returned per second", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [
      {"expr": "rate(pg_stat_database_tup_returned{datname=\"shop\"}[30s])", "legendFormat": "tuples returned/s"}
    ]},
    {"id": 4, "type": "timeseries", "title": "Observed OJP slow SQL classifications", "datasource": {"uid": "prometheus", "type": "prometheus"}, "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [
      {"expr": "sum by(instance)(rate(ojp_sql_slow_executions_total[30s]))", "legendFormat": "{{instance}} slow SQL/s"}
    ]}
  ]
}
