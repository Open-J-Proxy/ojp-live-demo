{
  "uid": "ojp-overview",
  "title": "OJP • Load protection demo",
  "description": "A focused view of offered traffic, accepted work, end-to-end latency, backpressure, and the slowest OJP SQL statements.",
  "tags": ["ojp", "demo", "prometheus"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "utc",
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s", "30s", "1m", "5m"]},
  "links": [{"title": "Live JDBC benchmark", "type": "link", "url": "/d/ojp-benchmark", "keepTime": true}],
  "annotations": {"list": [{"name": "Annotations & Alerts", "type": "dashboard", "builtIn": 1, "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "datasource": {"type": "grafana", "uid": "-- Grafana --"}}]},
  "templating": {
    "list": [
      {"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1, "hide": 0, "current": {"text": "Prometheus", "value": "prometheus"}, "options": []},
      {"name": "mode", "type": "query", "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"}, "query": "label_values(demo_load_scheduled_total, mode)", "includeAll": true, "multi": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}},
      {"name": "phase", "type": "custom", "query": "measure,warmup", "current": {"text": "measure", "value": "measure"}},
      {"name": "scenario", "type": "query", "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"}, "query": "label_values(demo_load_scheduled_total, scenario)", "includeAll": true, "multi": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}},
      {"name": "level", "type": "query", "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"}, "query": "label_values(demo_load_scheduled_total, level)", "includeAll": true, "multi": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Follow the load",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {"mode": "markdown", "content": "Compare Direct and OJP as offered load rises: requests offered → accepted → SQL completed, with end-to-end latency beside backpressure signals. Generator drops and app worker rejects are distinct from OJP backend waiters. OJP does not export a dedicated per-request throttle counter or user identity; these panels show observed demo traffic, not fabricated OJP rejection counts."}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request flow • offered, accepted, SQL completed",
      "description": "Rates by mode. Accepted is admission, not proof that SQL completed.",
      "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"},
      "gridPos": {"x": 0, "y": 3, "w": 14, "h": 8},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "targets": [
        {"refId": "A", "expr": "sum by(mode)(rate(demo_load_scheduled_total{mode=~\"$mode\",phase=\"$phase\",scenario=~\"$scenario\",level=~\"$level\"}[30s]))", "legendFormat": "{{mode}} offered"},
        {"refId": "B", "expr": "sum by(mode)(rate(demo_load_accepted_total{mode=~\"$mode\",phase=\"$phase\",scenario=~\"$scenario\",level=~\"$level\"}[30s]))", "legendFormat": "{{mode}} accepted"},
        {"refId": "C", "expr": "sum by(mode)(rate(demo_load_sql_completed_total{mode=~\"$mode\",phase=\"$phase\",scenario=~\"$scenario\",level=~\"$level\"}[30s]))", "legendFormat": "{{mode}} SQL completed"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "User-visible latency • P95 / P99",
      "description": "Time from scheduled arrival to reply, including client and server queueing.",
      "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"},
      "gridPos": {"x": 14, "y": 3, "w": 10, "h": 8},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95,sum by(le,mode)(rate(demo_load_latency_seconds_bucket{mode=~\"$mode\",phase=\"$phase\",scenario=~\"$scenario\",level=~\"$level\"}[30s])))", "legendFormat": "{{mode}} P95"},
        {"refId": "B", "expr": "histogram_quantile(0.99,sum by(le,mode)(rate(demo_load_latency_seconds_bucket{mode=~\"$mode\",phase=\"$phase\",scenario=~\"$scenario\",level=~\"$level\"}[30s])))", "legendFormat": "{{mode}} P99"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Load shedding • generator drops and app rejects",
      "description": "Generator drops are caused by its in-flight cap; HTTP rejects come from the demo app's worker limit. Neither is an OJP rejection counter.",
      "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"},
      "gridPos": {"x": 0, "y": 11, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "sum by(mode)(rate(demo_load_dropped_total{mode=~\"$mode\",phase=\"$phase\",scenario=~\"$scenario\",level=~\"$level\"}[30s]))", "legendFormat": "{{mode}} generator drops/s"},
        {"refId": "B", "expr": "rate(demo_rejected_total[30s])", "legendFormat": "App worker rejects/s"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "OJP backend waiters",
      "description": "Current requests waiting for an OJP backend connection; pool pressure, not an admission rejection count.",
      "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"},
      "gridPos": {"x": 12, "y": 11, "w": 12, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "No data"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "value_and_name", "colorMode": "value", "graphMode": "none"},
      "targets": [
        {"refId": "A", "expr": "sum by(instance)(ojp_hikari_pool_connections_pending_threads)", "instant": true, "range": false, "legendFormat": "{{instance}}"}
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Slowest OJP SQL • mean latency",
      "description": "Top 10 statement/instance pairs by mean execution time over the selected range. Low-volume statements can rank highly. OJP metrics identify SQL statements, not end users; raw SQL labels may contain sensitive data.",
      "datasource": {"uid": "${DS_PROMETHEUS}", "type": "prometheus"},
      "gridPos": {"x": 0, "y": 19, "w": 24, "h": 11},
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "No data",
          "custom": {"align": "auto", "cellOptions": {"type": "auto"}, "filterable": true}
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "Value"}, "properties": [{"id": "displayName", "value": "Mean latency"}]}
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{"displayName": "Mean latency", "desc": true}]
      },
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true}}}],
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by(job,instance,sql_statement)(increase(ojp_sql_execution_time_milliseconds_sum{job=~\"ojp(-ha)?\"}[$__range])) / (sum by(job,instance,sql_statement)(increase(ojp_sql_execution_time_milliseconds_count{job=~\"ojp(-ha)?\"}[$__range])) > 0))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    }
  ]
}
